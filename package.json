{
  "name": "forgesworn.dev",
  "version": "1.0.0",
  "private": true,
  "description": "ForgeSworn organisation landing page",
  "type": "module",
  "scripts": {
    "sync": "curl -fsSL https://raw.githubusercontent.com/forgesworn/.github/main/forgesworn-repos.json -o forgesworn-repos.json",
    "build": "node scripts/build-site.mjs",
    "check:drift": "node scripts/check-catalogue-drift.mjs",
    "test": "node --test test/*.test.mjs",
    "test:media:lifecycle": "node test/media-player-lifecycle.mjs",
    "test:media:showcase:lifecycle": "node test/media-showcase-lifecycle.mjs",
    "test:media:peer": "node test/media-peer-browser.mjs",
    "test:media:ui": "node test/media-ui-browser.mjs",
    "demo:media": "node scripts/serve-media-demo.mjs",
    "demo:package": "node scripts/package-media-demo.mjs",
    "demo:compare": "node scripts/media-lab-server.mjs",
    "demo:broadcast": "node scripts/package-media-broadcast.mjs",
    "map": "node scripts/build-map.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
